// Schema de dados — Sistema de Controle de Projetos e Tarefas Zinzane
//
// Cada projeto e cada tarefa pertence a um Departamento (workspace).
// O acesso é controlado por UserDepartment: uma pessoa só enxerga os
// departamentos aos quais está vinculada, exceto administradores.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DepartmentRole {
  MEMBRO
  GESTOR
}

enum Priority {
  ALTA
  MEDIA
  BAIXA
}

enum ProjectStatus {
  NAO_INICIADO
  EM_ANDAMENTO
  CONCLUIDO
  BLOQUEADO
}

enum TaskStatus {
  TODO
  DOING
  REVIEW
  DONE
  BLOCKED
}

model Department {
  id        String   @id @default(uuid())
  nome      String   @unique
  slug      String   @unique
  cor       String?
  createdAt DateTime @default(now())

  members  UserDepartment[]
  projects Project[]
  tasks    Task[]

  @@map("departments")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  cargo        String?
  color        String?
  createdAt    DateTime @default(now())

  departments     UserDepartment[]
  responsibleFor  Project[]        @relation("ProjectResponsible")
  tasksAssigned   Task[]           @relation("TaskResponsible")
  taskAssignments TaskAssignee[]
  salaries        Salary[]

  @@map("users")
}

// Vincula uma pessoa a um departamento (workspace) com um papel.
// Isso é o que decide o que cada pessoa enxerga no sistema.
model UserDepartment {
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  role         DepartmentRole @default(MEMBRO)
  createdAt    DateTime       @default(now())

  @@id([userId, departmentId])
  @@map("user_departments")
}

model Project {
  id             String        @id @default(uuid())
  departmentId   String
  department     Department    @relation(fields: [departmentId], references: [id])
  titulo         String
  descricao      String?
  responsavelId  String?
  responsavel    User?         @relation("ProjectResponsible", fields: [responsavelId], references: [id])
  prioridade     Priority      @default(MEDIA)
  status         ProjectStatus @default(NAO_INICIADO)
  prazo          DateTime?
  orcamentoTotal Decimal?      @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tasks Task[]

  @@map("projects")
}

model Task {
  id            String     @id @default(uuid())
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id])
  projectId     String?
  project       Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  titulo        String
  descricao     String?
  // Legado — mantido só por compatibilidade com dados antigos, não é mais
  // escrito/lido pela aplicação. Uma tarefa agora pode ter vários
  // responsáveis (inclusive de departamentos diferentes) via `assignees`.
  responsavelId String?
  responsavel   User?      @relation("TaskResponsible", fields: [responsavelId], references: [id])
  assignees     TaskAssignee[]
  prioridade    Priority   @default(MEDIA)
  status        TaskStatus @default(TODO)
  prazo         DateTime?
  tags          String[]   @default([])
  concluidaEm   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  timeEntries TaskTimeEntry[]

  @@map("tasks")
}

// Vincula uma ou mais pessoas como responsáveis por uma tarefa. Permite que
// uma tarefa seja compartilhada entre pessoas de departamentos diferentes
// (a pessoa não precisa ser membro do departamento da tarefa pra ser
// responsável por ela).
model TaskAssignee {
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([taskId, userId])
  @@map("task_assignees")
}

model TaskTimeEntry {
  id                 String    @id @default(uuid())
  taskId             String
  task               Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  inicio             DateTime
  fim                DateTime?
  segundosAcumulados Int       @default(0)

  @@map("task_time_entries")
}

// Dado sensível — visível só para admins e para o Gestor do
// Departamento Pessoal (regra aplicada na camada da API, não aqui).
model Salary {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  valor          Decimal   @db.Decimal(12, 2)
  vigenciaInicio DateTime
  vigenciaFim    DateTime?
  createdAt      DateTime  @default(now())

  @@map("salaries")
}
