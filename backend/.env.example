# Preenchido automaticamente pelo Railway ao anexar o Postgres do projeto
DATABASE_URL="postgresql://user:password@localhost:5432/zinzane"

# Gere um valor aleatório forte para produção (ex: openssl rand -hex 32)
JWT_SECRET="troque-este-valor-em-producao"

# Origem permitida para CORS — URL pública do frontend no Railway
FRONTEND_URL="http://localhost:5173"

# Opcional: usado pela rota de importação via IA (/api/ai/import)
ANTHROPIC_API_KEY=""

PORT=4000
